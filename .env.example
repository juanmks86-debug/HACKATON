# Copiá este archivo a .env y completá lo que necesites.
# Todo lo que empieza con VITE_ queda visible en el navegador: acá no van secretos.
# Nunca pongas la service_role de Supabase ni contraseñas de Gmail.

# URL pública de la API .NET 10. Si está vacía, la app usa la vista previa local.
VITE_API_BASE_URL=

# Supabase: la publishable / anon key es pública por diseño (la protección real es RLS).
# Si no las definís, se usan los valores por defecto de src/config.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
